# PostgreSQL 配置（复制为 .env）
# ⚠️ .env 里的值会被 compose 做 ${} 变量插值，密码里的字面 $ 必须写成 $$

# ---- 镜像版本 ----
# 锁大版本！不要写 latest，也不要随手改大版本号（17 → 18 会导致无法启动）。
# 升级方式见 README 的「大版本升级」章节。
POSTGRES_TAG=17-alpine

# ---- 端口（PostgreSQL 默认端口，只绑 127.0.0.1）----
POSTGRES_PORT=5432

# ---- 初始库和账号（仅首次启动、数据目录为空时生效）----
POSTGRES_DB=homelab
POSTGRES_USER=homelab

# 密码：只用字母和数字！
# 原因：密码常常要拼进 postgres://user:pass@host/db 这样的 URL，
#       含 @ : / ? # 等字符要做 URL 编码，很容易出错。直接避开。
# 生成命令：openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# ---- 性能参数 ----
# 最大连接数，每连接约占 5-10MB 内存
PG_MAX_CONNECTIONS=100
# 共享缓冲区，建议设为物理内存的 25%（4G 内存机器就写 1GB）
PG_SHARED_BUFFERS=256MB
