# MySQL 配置（复制为 .env）
# ⚠️ .env 里的值会被 compose 做 ${} 变量插值，密码里的字面 $ 必须写成 $$

# ---- 镜像版本 ----
# 锁大版本 8.0！写 latest 会拉到 9.x，数据目录不兼容且无法降级。
MYSQL_TAG=8.0

# ---- 端口（MySQL 默认端口，只绑 127.0.0.1）----
MYSQL_PORT=3306

# ---- 初始库和账号（仅首次启动、数据目录为空时生效）----
MYSQL_DATABASE=homelab
MYSQL_USER=homelab

# 密码：只用字母和数字（会拼进连接 URL，避开转义问题）
# 生成命令：openssl rand -hex 24
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_PASSWORD=CHANGE_ME_USER

# ---- 性能参数 ----
# InnoDB 缓冲池，MySQL 最重要的性能参数，建议物理内存的 50-70%
# 4G 内存机器写 2G，8G 写 4G
MYSQL_BUFFER_POOL=512M
