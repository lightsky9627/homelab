# ======================================================================
#  全局默认环境变量（复制为 .env）
#
#  这里放「所有应用共享」的配置。每个应用目录下还有自己的 .env，
#  两者会一起加载，同名变量以应用自己的 .env 为准（后加载的覆盖先加载的）。
#
#  加载顺序由 bin/hl 脚本保证：
#      根目录 .env  →  应用目录 .env
# ======================================================================

# ---- 时区：影响所有容器的日志时间戳、数据库 now()、定时任务触发时刻 ----
TZ=Asia/Shanghai

# ---- 镜像仓库前缀 ----
# 直连 Docker Hub 很慢，这里统一走镜像站。所有 compose 文件里的镜像都写成
#   ${REGISTRY}/library/postgres:17-alpine     （官方镜像要带 library/）
#   ${REGISTRY}/neosmemo/memos:stable          （第三方镜像直接用原路径）
#
# 可选值：
#   hub.bravexist.cn              公网镜像站（默认）
#   harbor.qx.lab/dockerhub       内网 harbor，在公司网络里更快
#   docker.io                     官方源，不走加速
REGISTRY=hub.bravexist.cn

# ---- 你的主域名 ----
# 反代脚本 bin/hl proxy add 会用它拼默认域名，例如输入应用名 memos
# 就默认生成 memos.example.com，省得每次敲全。
BASE_DOMAIN=example.com

# ---- ACME 证书申请邮箱 ----
# Let's Encrypt 会在证书快过期时发邮件提醒，建议填真实邮箱
ACME_EMAIL=you@example.com

# ---- 数据根目录 ----
# 默认每个应用把数据放在自己目录下的 data/（已被 git 忽略）。
# 如果你想把数据统一放到大盘（例如 /srv/homelab-data），改这里，
# 各应用的 compose 会用 ${DATA_ROOT} 拼路径。
DATA_ROOT=./data
