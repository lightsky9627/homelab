# RustDesk 配置（复制为 .env）

# ---- 镜像版本 ----
RUSTDESK_TAG=latest

# ---- 端口绑定地址 ----
# ⚠️ RustDesk 客户端走自有 TCP/UDP 协议，HTTP 反代转发不了，
#    必须直接对公网开放，所以这里用 0.0.0.0。
#    记得在防火墙/安全组放行：TCP 21115-21119、UDP 21116
#
# 如果只在内网用，可以改成 127.0.0.1 或内网网卡 IP。
BIND_ADDR=0.0.0.0

# ---- hbbs / hbbr 额外启动参数 ----
# 强烈建议加 -k _ ：强制客户端校验服务端公钥，防止中间人攻击。
# 加了之后客户端配置里必须填对公钥（公钥在 data/id_ed25519.pub，
# 首次启动自动生成，用 bin/hl rustdesk key 可以直接打印出来）。
RUSTDESK_HBBS_OPTS=-k _
RUSTDESK_HBBR_OPTS=-k _
