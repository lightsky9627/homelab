# Memos 配置（复制为 .env）

# ---- 镜像版本 ----
# stable 是 memos 官方的滚动稳定标签，配合 watchtower 自动更新。
# 注意 memos 没有 latest 标签，别写成 latest（会拉取失败）。
MEMOS_TAG=stable

# ---- 端口（memos 默认端口，只绑 127.0.0.1）----
MEMOS_PORT=5230

# ---- 对外访问地址 ----
# @required 必须和实际访问域名完全一致（含 https://），否则分享链接、RSS 会指向错误地址
MEMOS_INSTANCE_URL=https://memos.example.com

# ---- 数据库 ----
# 用 memos 自带的 SQLite，库文件在 ./data/memos/memos_prod.db。
# 不需要任何配置，也不需要先起 PostgreSQL。

# ---- 容器运行用户 ----
# 容器以 root 起、修完数据目录权限后降权到这个 UID/GID
MEMOS_UID=10001
MEMOS_GID=10001
