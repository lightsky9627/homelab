# Memos 配置（复制为 .env）

# ---- 镜像版本 ----
# stable 是 memos 官方的滚动稳定标签，配合 watchtower 自动更新。
# 注意 memos 没有 latest 标签，别写成 latest（会拉取失败）。
MEMOS_TAG=stable

# ---- 端口（memos 默认端口，只绑 127.0.0.1）----
MEMOS_PORT=5230

# ---- 对外访问地址 ----
# 必须和实际访问域名完全一致（含 https://），否则分享链接、RSS 会指向错误地址
MEMOS_INSTANCE_URL=https://memos.example.com

# ---- 数据库（用 infra/postgresql 的共享实例）----
# 执行 bin/hl db create memos 会自动建库建账号并打印密码，把密码粘到这里
DB_NAME=memos
DB_USER=memos
DB_PASSWORD=CHANGE_ME
# 说明：不需要配数据库主机和端口。
# memos 容器会加入 homelab-db 网络，直接用容器名 postgresql:5432 连接。

# ---- 容器运行用户 ----
# 容器以 root 起、修完数据目录权限后降权到这个 UID/GID
MEMOS_UID=10001
MEMOS_GID=10001
