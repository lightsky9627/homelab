# Vaultwarden 配置（复制为 .env）
# ⚠️ .env 里的值会被 compose 做 ${} 插值，密码里的字面 $ 必须写成 $$

# ---- 镜像版本 ----
# latest 是官方滚动标签（debian 版），配合 watchtower 自动更新。
# 想要更小体积可改 alpine，但 debian 兼容性更稳。
VAULTWARDEN_TAG=latest

# ---- 端口 ----
# 容器内固定 80，这里只决定宿主端口（只绑 127.0.0.1，由 Caddy 反代）
VAULTWARDEN_PORT=8080

# ---- 对外访问地址 ----
# @required 必须和实际访问域名完全一致（含 https://），否则 WebAuthn / 邮件链接会出错
DOMAIN=https://vault.example.com

# ---- 基础 ----
# 日志级别：trace / debug / info / warn / error
LOG_LEVEL=warn
# Web 端（网页版保险库）
WEB_VAULT_ENABLED=true
# 新设备登录要邮箱验证码（需要配好 SMTP 才有效）
REQUIRE_DEVICE_EMAIL=true

# ---- 注册策略 ----
# 首次部署建议临时改成 true，注册完第一个账号后改回 false
SIGNUPS_ALLOWED=false
# 之后靠 /admin 面板的邀请链接加人
INVITATIONS_ALLOWED=true
# 只允许某些域名邮箱注册（可选）
# SIGNUPS_DOMAINS_WHITELIST=example.com

# ---- 附件配额（KB；0=禁止上传）----
# 限的是「累计总量」不是单文件大小
USER_ATTACHMENT_LIMIT=204800      # 单用户累计 200 MB
ORG_ATTACHMENT_LIMIT=1024000      # 单组织累计 1000 MB

# ---- SMTP（可留空，留空则用不了邮件邀请/找回/设备验证码）----
SMTP_FROM_NAME=Vaultwarden
SMTP_HOST=
SMTP_FROM=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- 移动端推送通知（可选）----
# 在 https://bitwarden.com/host/ 申请
PUSH_ENABLED=false
PUSH_INSTALLATION_ID=
PUSH_INSTALLATION_KEY=
# 欧盟区域需要额外指定：
# PUSH_RELAY_URI=https://api.bitwarden.eu
# PUSH_IDENTITY_URI=https://identity.bitwarden.eu

# ---- YubiKey OTP 二次验证（可选）----
YUBICO_CLIENT_ID=
YUBICO_SECRET_KEY=

# ---- Duo 二次验证（企业场景，可选）----
# DUO_IKEY=
# DUO_SKEY=
# DUO_HOST=
