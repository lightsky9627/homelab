# 备份调度器配置（复制为 .env）
# 注意：对象存储的密钥不在这里，在 repo.env（由 bin/hl backup init 生成）

# ---- 镜像版本 ----
ALPINE_TAG=latest
RESTIC_TAG=latest

# ---- 备份计划（5 段 cron：分 时 日 月 周，注意和 watchtower 的 6 段不同）----
# 默认每天凌晨 3:30（排在 watchtower 的 4:00 自动更新之前，
# 这样万一更新出问题，当天的备份已经完成了）
#   每 6 小时：  30 */6 * * *
#   每周日 2 点：0 2 * * 0
BACKUP_SCHEDULE=30 3 * * *
