# ======================================================================
#  restic 仓库配置（复制为 repo.env）
#
#  ⚠️ 这个文件含对象存储密钥和仓库密码，已被 .gitignore 忽略，
#     绝对不要提交到 git。建议 chmod 600。
#
#  推荐用交互式向导生成，会帮你选后端、填参数、测试连通性：
#      bin/hl backup init
# ======================================================================

# ---- 仓库地址 ----
# 格式取决于后端类型，选一种：
#
# 1) S3 兼容（AWS S3 / MinIO / 阿里云 OSS / 腾讯云 COS / Cloudflare R2）
#    RESTIC_REPOSITORY=s3:https://s3.us-west-1.amazonaws.com/my-bucket/homelab
#    Cloudflare R2 示例：
#    RESTIC_REPOSITORY=s3:https://<account_id>.r2.cloudflarestorage.com/my-bucket
#    阿里云 OSS 示例：
#    RESTIC_REPOSITORY=s3:https://oss-cn-hangzhou.aliyuncs.com/my-bucket/homelab
#
# 2) Backblaze B2（便宜，适合冷备份）
#    RESTIC_REPOSITORY=b2:my-bucket:homelab
#
# 3) 本地目录 / 挂载的 NAS（没有对象存储时先用这个）
#    RESTIC_REPOSITORY=/mnt/backup/homelab
#
# 4) 另一台机器（走 SFTP）
#    RESTIC_REPOSITORY=sftp:user@host:/backup/homelab
RESTIC_REPOSITORY=s3:https://s3.example.com/my-bucket/homelab

# ---- 仓库加密密码 ----
# ⚠️⚠️ 最重要的一行：这个密码丢了，所有备份都永久无法解密，没有任何找回办法。
#      请务必抄一份存到密码管理器（Vaultwarden / 1Password）里！
# 生成：openssl rand -base64 32
RESTIC_PASSWORD=CHANGE_ME_AND_SAVE_IT_SOMEWHERE_SAFE

# ---- 对象存储凭据（S3 类后端用）----
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# ---- S3 寻址风格（可选，默认 auto）----
# restic 的 backend 选项，逗号分隔多个 key=value。
# 由 backup-lib.sh 转成 -o 参数传给 restic，不要写成别的格式。
#
# 常见问题：腾讯云 COS / 阿里云 OSS 强制虚拟主机风格，
# 选 auto 时 restic 可能误走路径风格报
#   "must be addressed using COS virtual-styled domain"
# 这种情况改成 dns：
# RESTIC_OPTIONS=s3.bucket-lookup=dns
#
# 取值：
#   auto  自动检测（默认）
#   dns   强制虚拟主机风格（主流云厂商）
#   path  强制路径风格（自建 MinIO/Ceph 没配泛域名时）
RESTIC_OPTIONS=s3.bucket-lookup=auto

# ---- Backblaze B2 凭据（用 B2 后端时才填，上面两个就留空）----
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=

# ======================================================================
#  保留策略 —— 控制留多少份历史快照
#
#  restic forget 按这几个维度保留，是"每个维度各自保留 N 个"，
#  一份快照只要满足任一条件就不会被删。
#  下面这组配置最终大约保留 7+4+6 ≈ 17 份快照，
#  由于增量去重，实际占用空间通常只有单份全量的 1.5-3 倍。
# ======================================================================

# 保留最近 N 天的每日快照
KEEP_DAILY=7
# 保留最近 N 周的每周快照
KEEP_WEEKLY=4
# 保留最近 N 月的每月快照
KEEP_MONTHLY=6
# 无论如何都保留最近 N 份（防止长期没备份时把仅有的几份删光）
KEEP_LAST=3

# ---- 空间上限（可选，单位 GB，留空表示不限制）----
# 每次备份后检查仓库总大小，超过这个值会在日志里告警。
# 注意：restic 没有硬性容量限制功能，这里只做告警提醒，
# 真要控制成本请在对象存储侧设生命周期规则或配额。
MAX_REPO_SIZE_GB=50

# ---- 备份完成后发通知（可选）----
# 和 watchtower 一样用 shoutrrr 格式，留空则不通知
# NOTIFY_URL=telegram://<token>@telegram?chats=<chat_id>
