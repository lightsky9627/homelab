# Watchtower 配置（复制为 .env）

# ---- 镜像版本 ----
WATCHTOWER_TAG=latest

# ---- docker API 版本 ----
# watchtower 内置客户端默认 API 太旧会被新 daemon 拒绝，必须显式指定。
# 查你本机的值：docker version --format '{{.Server.APIVersion}}'
DOCKER_API_VERSION=1.55

# ---- 检查计划（6 段 cron：秒 分 时 日 月 周）----
# 默认每天凌晨 4:00 检查一次
#   每 6 小时一次： 0 0 */6 * * *
#   每周日凌晨 3 点：0 0 3 * * 0
WATCHTOWER_SCHEDULE=0 0 4 * * *

# ---- 可选：更新完发通知（shoutrrr URL）----
# Telegram: telegram://<bot_token>@telegram?chats=<chat_id>
# Bark:     bark://<device_key>@<server>
# WATCHTOWER_NOTIFICATION_URL=
